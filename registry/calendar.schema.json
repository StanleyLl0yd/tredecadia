{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StanleyLl0yd/tredecadia/raw/main/registry/calendar.schema.json",
  "title": "Tredecadia calendar profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specVersion", "status", "profile", "era", "regularGrid", "epoch", "civilAnchor", "leapRule", "intercalary"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "specVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "stable"]},
    "profile": {"const": "tredecadia-civil"},
    "era": {"const": {"name": "Tredecadia Era", "symbol": "TE", "yearNumbering": "all-integers", "yearZero": true, "canonicalMinimumDigits": 5}},
    "regularGrid": {"const": {"monthsPerYear": 13, "daysPerMonth": 28, "regularDaysPerYear": 364, "weeksPerMonth": 4, "weekdays": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]}},
    "epoch": {"const": {"tredecadia": "00000-EQ", "gregorianAstronomical": {"year": -9999, "month": 3, "day": 20}}},
    "civilAnchor": {"const": {"equinoxDay": {"gregorianYearFormula": "Y-9999", "month": 3, "day": 20, "opensYear": true}, "regularYearStart": {"gregorianYearFormula": "Y-9999", "month": 3, "day": 21}, "earthDay": {"gregorianYearFormula": "Y-9998", "month": 3, "day": 19, "leapOnly": true, "closesYear": true}}},
    "leapRule": {"const": {"kind": "proleptic-gregorian-astronomical-year", "gregorianYearFormula": "Y-9998"}},
    "intercalary": {"const": [{"code": "EQ", "name": "Equinox / New Year Day", "position": "start", "leapOnly": false, "hasMonth": false, "hasWeekday": false}, {"code": "ED", "name": "Earth Day", "position": "end", "leapOnly": true, "hasMonth": false, "hasWeekday": false}]}
  }
}
