{
  "specVersion": "1.1.0-rc.1",
  "policyVersion": 1,
  "preferredConversationalForm": "short4",
  "exactMatch": {
    "caseInsensitive": true,
    "requiresMonthContextOutsideStructuredFields": true
  },
  "knownClosePairs": {
    "characterLevenshtein1": [
      [
        "Nazu",
        "Kazu"
      ],
      [
        "Yani",
        "Yana"
      ]
    ],
