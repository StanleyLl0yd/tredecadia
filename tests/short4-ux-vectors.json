      "kind": "month-picker",
      "structuredMonthContext": true,
      "short4Safe": true
    },
    {
      "kind": "calendar-header",
      "structuredMonthContext": true,
      "short4Safe": true
    },
    {
      "kind": "date-chip",
      "structuredMonthContext": true,
